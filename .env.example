# ==========================================
# PUBLIC VARIABLES (Safe for Browser/Vite)
# ==========================================

# Supabase Project
VITE_SUPABASE_URL="your-project-url"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ==========================================
# SECRET VARIABLES (Supabase Edge Functions / Vault ONLY)
# NEVER EXPOSE THESE TO THE FRONTEND
# ==========================================

# Groq API for LLM Evaluation
GROQ_API_KEY="your-groq-api-key"

# GitHub OAuth / API
# (These will likely be managed via Supabase Auth dashboard, but good to have for local Edge Function testing)
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Used by GitHub Actions to sync state
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
